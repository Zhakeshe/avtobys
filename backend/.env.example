# Server
PORT=4000
NODE_ENV=development

# Admin auth
ADMIN_TOKEN=avtobys-admin-dev

# Database (optional, if empty local in-memory DB is used)
DATABASE_URL=
DATABASE_SSL=false

# Support contacts
SUPPORT_TELEGRAM=@aqxrx
ACCESS_REQUEST_TELEGRAM=@aqxrx

# Telegram login delivery
# Bot username must be WITHOUT @ (example: avtobyskzzbot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_DEFAULT_CHAT_ID=

# Optional phone -> chat mapping JSON
# Example: {"+77001234567":"123456789"}
TELEGRAM_CHAT_MAP_JSON={}

# Use polling when HTTPS webhook is not available
TELEGRAM_POLLING=true
